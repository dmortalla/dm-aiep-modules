# Repository text normalization policy.
#
# Source, configuration, documentation, and web assets use LF on every
# platform. Windows-native command scripts retain CRLF.
#
# This prevents Git autocrlf settings on individual developer machines from
# silently changing Python/source line endings or producing recurring
# "LF will be replaced by CRLF" warnings.

* text=auto

*.py      text eol=lf
*.pyi     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.sh      text eol=lf

*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.pdf     binary
